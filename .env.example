# MediGuard configuration. Copy to `.env` and adjust. All defaults are free/local.

# --- Knowledge Graph backend ---
# "embedded" = NetworkX in-process, zero infra (default, works everywhere).
# "neo4j"    = connect to a running Neo4j (requires Docker or a Neo4j install).
MEDIGUARD_KG_BACKEND=embedded

# Neo4j connection (only used when MEDIGUARD_KG_BACKEND=neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mediguard

# --- Explanation layer ---
# "template" = deterministic evidence-grounded text, fully free, no API key (default).
# "claude"   = Claude API (needs ANTHROPIC_API_KEY, paid).
# "ollama"   = local model via Ollama (free, needs Ollama running).
MEDIGUARD_EXPLAIN_BACKEND=template
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# --- External APIs (all free, no key) ---
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST

# --- Feature flags ---
MEDIGUARD_ENABLE_GNN=false
MEDIGUARD_INDIA_LAYER=false
